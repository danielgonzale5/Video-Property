# Copy this file to .env. Nothing here is required for the demo.

# Runway API (dev.runwayml.com): turns each photo into a camera-motion clip.
# Without a key, photos are animated with a slow zoom and pan inside Remotion.
RUNWAY_API_KEY=

# Runway models. RUNWAY_PREMIUM_MODEL is only used for scenes marked "premium": true.
# For walkthroughs (style "walkthrough") pick a model that accepts a last frame: veo3.1_fast, seedance2_mini...
# API prices ($0.01/credit): gen4_turbo 5 cr/s, veo3.1_fast without audio 10 cr/s,
# gen4.5 12 cr/s, seedance2_mini 16 cr/s, veo3.1 without audio 20 cr/s.
RUNWAY_MODEL=veo3.1_fast
RUNWAY_PREMIUM_MODEL=veo3.1_fast

# Anthropic API (console.anthropic.com): not used yet. Reserved for automating
# photo analysis and quality checks.
ANTHROPIC_API_KEY=
